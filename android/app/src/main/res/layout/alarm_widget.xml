<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/alarm_widget_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/alarm_widget_flame_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_flame"
            tools:tint="#F97316" />

        <TextView
            android:id="@+id/alarm_widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            tools:text="12" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/alarm_widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ALARM+"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:textColor="#22C55E" />
    </LinearLayout>

    <TextView
        android:id="@+id/alarm_widget_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        tools:text="day streak" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/alarm_widget_next_alarm"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#22C55E"
            tools:text="06:30 AM" />

        <ImageButton
            android:id="@+id/alarm_widget_snooze"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_pause"
            android:contentDescription="Snooze" />

        <ImageButton
            android:id="@+id/alarm_widget_toggle"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:padding="6dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_idle_alarm"
            android:contentDescription="Toggle next alarm" />
    </LinearLayout>
</LinearLayout>
