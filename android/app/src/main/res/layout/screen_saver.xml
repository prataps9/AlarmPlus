<?xml version="1.0" encoding="utf-8"?>
<!-- Alarm+ screen saver (AlarmScreenSaver): flat night palette, no gradients. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/saver_block"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#D6D3D1"
            android:textSize="96sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:textColor="#A8A29E"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/saver_next_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FB923C"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
