<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alarm_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/alarm_widget_background"
    android:padding="16dp">

    <TextView
        android:id="@+id/alarm_widget_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        tools:text="🔥🔥 12" />

    <TextView
        android:id="@+id/alarm_widget_streak_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#94A3B8"
        android:layout_marginBottom="10dp"
        tools:text="day streak" />

    <TextView
        android:id="@+id/alarm_widget_next_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#22C55E"
        tools:text="06:30 AM" />
</LinearLayout>
